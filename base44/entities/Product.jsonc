{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "scale": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "feature"
      ],
      "default": "medium"
    },
    "material": {
      "type": "string"
    },
    "dimensions": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "price",
    "image_url"
  ]
}